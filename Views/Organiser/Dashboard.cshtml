@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Organiser Dashboard</h2>
    <div class="row">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Manage Events</h5>
                    <p class="card-text">Create, edit, or delete events and upload banner images.</p>
                    <a asp-action="ManageEvents" class="btn btn-light">Go to Events</a>
                </div>
            </div>
        </div>
    </div>
</div>